<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seguidor_interfaces</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="alanvignolo1999@gmail.com">raspberryAlan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <!-- Necesario para generar el código a partir de los .srv al compilar -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <!-- Necesario para usar ese código al ejecutar -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- Marca este paquete como un paquete de interfaces -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Las acciones usan mensajes internos de ROS2 para el estado y la cancelación -->
  <depend>action_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
